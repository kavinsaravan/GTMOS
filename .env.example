# Placeholders only. Real values live in AWS Secrets Manager (deployed) or a local,
# git-ignored .env (development). Names are illustrative; verify against each SDK.

# --- AWS ---
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=<approved-model-or-inference-profile-id>
DYNAMODB_TABLE_NAME=gtmos
S3_EVIDENCE_BUCKET=<bucket>

# --- Graph (Neo4j AuraDB) ---
NEO4J_URI=<aura-uri>
NEO4J_USERNAME=<username>
NEO4J_PASSWORD=<secret>

# --- Discovery / enrichment ---
TAVILY_API_KEY=<secret>
HUNTER_API_KEY=<secret>

# --- Messaging (live send, only after human approval + separate Send action) ---
SENDGRID_API_KEY=<secret>
SENDGRID_FROM_EMAIL=<verified-sender>
# Comma-separated recipient emails/domains allowed to receive real mail.
# If empty, sends are refused. Keeps live sending scoped while the product is tested.
OUTBOUND_ALLOWLIST=
GMAIL_OAUTH_CLIENT_ID=<client-id>
GMAIL_OAUTH_CLIENT_SECRET=<secret>

# --- Sponsors ---
BAND_API_KEY=<only-if-supported-by-provider>
FLEXPRICE_API_KEY=<secret>
FLEXPRICE_BASE_URL=<verified-service-url>
SNYK_TOKEN=<CI-secret-only>

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=<api-gateway-invoke-url>
